# ---------------------------------------------------------------------------
# atlas-auth-broker-worker — configuración de ejemplo.
#
# NINGÚN valor real vive en este archivo. En producción, el material sensible
# (secretos de cliente, claves privadas, claves maestras) se entrega por el
# gestor de secretos, no por variables de entorno en claro: ver
# AUTH_BROKER_VAULT_DRIVER=kms.
# ---------------------------------------------------------------------------

# --- Servidor -------------------------------------------------------------
AUTH_BROKER_PORT=3020
AUTH_BROKER_SHUTDOWN_TIMEOUT_SECONDS=15

# Token de servicio que AtlasBackend presenta al broker. Debe tener al menos 32
# caracteres: es la única frontera entre "pedir un token de proveedor" y no.
AUTH_BROKER_SERVICE_TOKEN=

# --- Custodia de secretos -------------------------------------------------
# env  -> solo desarrollo: lee los secretos de las variables de entorno.
# kms  -> producción: cifrado de sobre; la DEK se envuelve con una clave maestra
#         gestionada por el KMS y el material en claro nunca se persiste.
AUTH_BROKER_VAULT_DRIVER=env

# Clave maestra de envoltura para el driver `kms` en pruebas locales, en base64
# de 32 bytes. En producción se sustituye por el CMK del KMS y esta variable
# queda vacía.
AUTH_BROKER_MASTER_KEY_BASE64=

# Ruta de migración desde el modelo actual de AtlasBackend, donde las credenciales ya
# viven en variables de entorno: al arrancar, siembra el vault cifrado con los valores
# AUTH_BROKER_SECRET__* presentes. Solo tiene efecto con el driver `kms`. Una vez
# sembrado, retire esas variables del despliegue y vuelva a poner esto en `false`.
AUTH_BROKER_SEED_SECRETS_FROM_ENV=false

# Vida máxima de una credencial antes de exigir rotación (NIST SP 800-57).
AUTH_BROKER_CREDENTIAL_MAX_AGE_DAYS=90
# Antelación con la que se avisa de una rotación pendiente.
AUTH_BROKER_ROTATION_WARNING_DAYS=14

# --- Broker de tokens salientes ------------------------------------------
# Margen con el que se renueva un token antes de expirar, para que ninguna
# request de negocio viaje con un token a punto de vencer.
AUTH_BROKER_TOKEN_REFRESH_SKEW_SECONDS=60
AUTH_BROKER_TOKEN_REQUEST_TIMEOUT_MS=8000
AUTH_BROKER_TOKEN_MAX_RETRIES=2

# --- Federación entrante (OIDC) ------------------------------------------
# Vida del `state`/`nonce` de una autorización en curso (RFC 6749 §10.12).
AUTH_BROKER_AUTHORIZATION_TTL_SECONDS=600

# --- Credenciales de proveedor (SOLO driver `env`, solo desarrollo) -------
# Formato: AUTH_BROKER_SECRET__<PROVIDER_CODE>__<CAMPO>
# AUTH_BROKER_SECRET__SEGIP__CLIENT_ID=
# AUTH_BROKER_SECRET__SEGIP__CLIENT_SECRET=
# AUTH_BROKER_SECRET__INFOCENTER__CLIENT_ID=
# AUTH_BROKER_SECRET__INFOCENTER__CLIENT_SECRET=
# AUTH_BROKER_SECRET__FACEBOOK_META__CLIENT_ID=
# AUTH_BROKER_SECRET__FACEBOOK_META__CLIENT_SECRET=
