{
  "name": "@business/atlas-auth-broker-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Worker especialista en autenticación con proveedores externos: custodia credenciales, emite y renueva tokens salientes, y federa identidad entrante (OIDC/social).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "docs"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:worker": "node dist/src/standalone/worker-main.js",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "smoke:e2e": "node scripts/e2e-smoke.mjs",
    "verify": "yarn build && yarn smoke:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build",
    "docker:build": "docker build -t atlas-auth-broker-worker:local ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
